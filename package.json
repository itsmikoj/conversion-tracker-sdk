{
  "name": "@your-org/conversion-tracker-sdk",
  "version": "1.0.0",
  "description": "Enterprise-grade conversion tracking SDK for React Native with Meta Ads, Google Analytics, and Apple Search Ads integration",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src --ext .ts,.tsx",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "prepublishOnly": "npm run build",
    "docs": "typedoc --out docs src/index.ts"
  },
  "keywords": [
    "conversion-tracking",
    "meta-ads",
    "facebook-pixel",
    "analytics",
    "react-native",
    "expo",
    "attribution",
    "mobile-analytics"
  ],
  "author": "Your Organization",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/your-org/conversion-tracker-sdk.git"
  },
  "peerDependencies": {
    "@react-native-async-storage/async-storage": "^1.17.0",
    "expo": ">=53.0.0",
    "expo-tracking-transparency": "~6.0.8",
    "react": ">=16.8.0",
    "react-native": ">=0.60.0",
    "react-native-fbsdk-next": ">=12.0.0"
  },
  "dependencies": {
    "crypto-js": "^4.2.0",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@types/crypto-js": "^4.2.0",
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "@types/react": "^19.2.0",
    "@types/react-native": "^0.72.0",
    "@types/uuid": "^9.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.50.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "jest": "^29.5.0",
    "prettier": "^3.0.0",
    "ts-jest": "^29.1.0",
    "typedoc": "^0.25.0",
    "typescript": "^5.2.0"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ]
}
